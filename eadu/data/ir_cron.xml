<odoo>
    <data noupdate="1">
        <record id="ir_cron_process_eadu_synchronize" model="ir.cron">
            <field name="name">Process Eadu Sync</field>
            <field name="model_id" ref="eadu.model_eadu_partner_any"/>
            <field name="state">code</field>
            <field name="code">model._synchronize()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_retry_eadu_queued_calls" model="ir.cron">
            <field name="name">Retry Eadu Queued Calls</field>
            <field name="model_id" ref="eadu.model_eadu_partner_any"/>
            <field name="state">code</field>
            <field name="code">model._retry_all_queued_calls()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>