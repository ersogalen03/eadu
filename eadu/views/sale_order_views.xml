<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_sale_project" model="ir.ui.view">
        <field name="name">sale.order.form.sale.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <button name="action_cancel" position="after">
                <button name="button_eadu_sync" type="object" string="Eadu Sync"/>
            </button>
            <notebook position='inside'>
                <page string="Eadu" name="page_eadu">
                    <group><field name="eadu_ident"/></group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>