<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_eadu_exchange_wizard" model="ir.actions.act_window">
        <field name="name">Connect EADU</field>
        <field name="res_model">eadu.exchange.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_eadu_exchange_wizard_form" model="ir.ui.view">
        <field name="name">eadu.exchange.wizard.form</field>
        <field name="model">eadu.exchange.wizard</field>
        <field name="arch" type="xml">
            <form string="Connect EADU">
                <sheet>
                    <group>
                        <field name="mode" widget="radio"/>
                        <field name="partner_id" required="1"/>
                    </group>
                    <group invisible="mode != 'generate'">
                        <field name="generated_token" placeholder="Generate a code, then send it to the other partner."/>
                    </group>
                    <group invisible="mode != 'receive'">
                        <field name="token" placeholder="Paste the EADU code you received"/>
                        <field name="guessed_partner_id" invisible="not guessed_partner_id"/>
                        <field name="remote_partner_name" invisible="not remote_partner_name"/>
                        <field name="remote_user_name" invisible="not remote_user_name"/>
                        <field name="remote_url" invisible="not remote_url"/>
                        <field name="remote_db" invisible="not remote_db"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generate Code"
                        class="btn-primary" invisible="mode != 'generate'"/>
                    <button name="action_receive" type="object" string="Connect"
                        class="btn-primary" invisible="mode != 'receive'"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eadu_partner_any" model="ir.actions.act_window">
        <field name="name">EADU Object Access</field>
        <field name="res_model">eadu.partner.any</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_eadu_partner_any_list" model="ir.ui.view">
        <field name="name">eadu.partner.any.list</field>
        <field name="model">eadu.partner.any</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="partner_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="eadu_ident"/>
                <field name="master_status"/>
                <field name="to_sync"/>
            </list>
        </field>
    </record>

    <record id="view_eadu_partner_any_form" model="ir.ui.view">
        <field name="name">eadu.partner.any.form</field>
        <field name="model">eadu.partner.any</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="eadu_ident"/>
                        <field name="master_status"/>
                        <field name="to_sync"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_eadu_root"
        name="Eadu"
        groups="base.group_system"
        sequence="99"/>

    <menuitem id="menu_eadu_exchange"
        name="Connect"
        parent="menu_eadu_root"
        action="action_eadu_exchange_wizard"
        groups="base.group_system"
        sequence="1"/>

    <menuitem id="menu_eadu_partner_any"
        name="Object Access"
        parent="menu_eadu_root"
        action="action_eadu_partner_any"
        groups="base.group_system"
        sequence="90"/>

</odoo>
