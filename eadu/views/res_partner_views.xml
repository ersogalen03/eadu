<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_eadu_form" model="ir.ui.view">
        <field name="name">res.partner.eadu.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="EADU" groups="base.group_system">
                    <group>
                        <field name="eadu_connection_partner_id" readonly="1"/>
                        <field name="eadu_connection_url" readonly="1"/>
                        <field name="eadu_connection_db" readonly="1"/>
                        <button name="action_open_eadu_exchange_wizard" type="object"
                            class="btn-secondary" string="Connect EADU"
                            invisible="eadu_connection_partner_id"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
