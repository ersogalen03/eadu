<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="eadu_product_product_form_view" model="ir.ui.view">
        <field name="name">product.product.form.eadu.catalog</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_eadu_open_merge_wizard"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-random"
                        invisible="not eadu_catalog or eadu_merge_state not in ('needs_review', 'auto_linked')">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Merge EADU</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="EADU" invisible="not eadu_catalog">
                    <group>
                        <group>
                            <field name="eadu_catalog"/>
                            <field name="eadu_merge_state"/>
                            <field name="eadu_origin_partner_id"/>
                            <field name="eadu_origin_ident"/>
                        </group>
                        <group>
                            <field name="eadu_remote_barcode"/>
                            <field name="eadu_remote_sale_price"/>
                        </group>
                    </group>
                    <group>
                        <field name="eadu_review_reason" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="eadu_product_merge_wizard_view_form" model="ir.ui.view">
        <field name="name">eadu.product.merge.wizard.form</field>
        <field name="model">eadu.product.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge EADU Product">
                <group>
                    <field name="source_product_id" readonly="1"/>
                    <field name="target_product_id"/>
                    <field name="move_supplierinfo"/>
                    <field name="copy_barcode"/>
                </group>
                <footer>
                    <button name="action_merge" type="object" string="Merge" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eadu_product" model="ir.actions.act_window">
        <field name="name">EADU Catalog Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('eadu_catalog', '=', True)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No EADU catalog products yet.
            </p>
            <p>
                Products pushed from an EADU partner database are native Odoo
                products. Uncertain imports stay inactive until reviewed or merged.
            </p>
        </field>
    </record>

    <record id="action_eadu_push_products" model="ir.actions.server">
        <field name="name">Push to Eadu Partners</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_eadu_push()</field>
    </record>

    <menuitem id="menu_eadu_root"
              name="Eadu"
              sequence="99"/>

    <menuitem id="menu_eadu_products"
              name="Catalog Products"
              parent="menu_eadu_root"
              action="action_eadu_product"
              sequence="10"/>

</odoo>
